# ==============================================================================
# MwohaOS Environment Configuration Example
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-mwohaos-foundation-milestone-0-secret-key-change-in-prod
MWOHAOS_ENVIRONMENT=development

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql://mwohaos:mwohaos@postgres:5432/mwohaos

# Redis & Celery Configuration (Redis 7+)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Timezone Configuration
MWOHAOS_TIMEZONE=Africa/Nairobi

# Networking & Security
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Email Backend (Console for Milestone 0)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10

# ==============================================================================
# AI Provider & Intelligence Configuration (Milestone 3)
# ==============================================================================
# Providers: 'gemini' (primary), 'huggingface' (fallback), 'none' (AI disabled)
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=huggingface

# Google Gemini API Configuration (Official API, Hosted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2

# Hugging Face Inference Providers Configuration (Fallback)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_PROVIDER=together
HUGGINGFACE_TIMEOUT_SECONDS=120
HUGGINGFACE_MAX_RETRIES=1

# Usage Budgets & Intelligence Thresholds
AI_MAX_REQUESTS_PER_RUN=20
AI_MAX_CONTENT_CHARS=50000
AI_ENABLE_FALLBACK=true
AI_MIN_CONFIDENCE_FOR_REUSE=0.80
OPPORTUNITY_CLOSING_SOON_DAYS=7
OPPORTUNITY_INTELLIGENCE_BATCH_SIZE=10
OPPORTUNITY_INTELLIGENCE_INTERVAL_MINUTES=30

