# ==============================================================================
# MwohaOS Environment Configuration Example
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-mwohaos-foundation-milestone-0-secret-key-change-in-prod
MWOHAOS_ENVIRONMENT=development

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql://mwohaos:mwohaos@postgres:5432/mwohaos

# Redis & Celery Configuration (Redis 7+)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Timezone Configuration
MWOHAOS_TIMEZONE=Africa/Nairobi

# Networking & Security
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Email Backend (Console for Milestone 0)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10
